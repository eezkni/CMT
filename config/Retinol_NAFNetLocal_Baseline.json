{
    "name": "Retinol_NAFNetLocal_Baseline", // experiments name
    "seed" : 1951581, // random seed, seed <0 represents randomization not used
    "log_level": "INFO",
    "use_non_deterministic": true,
    "debug": false,

    "path": { //set every part file path
        "base_dir": "experiments", // base path for all log except resume_state
        "code": "code", // code backup
        "log_file": "run.log",
        "iqa_csv": "iqa.csv",
        "tensorboard_log_dir": "tf-logs",
//        "profile_path": "tf-logs/profile",
        "profile_path": null,
        "results": "results",
        "checkpoint": "checkpoint",
//        "resume_state": "/path/to/checkpoint
//        "resume_state": "/path/to/checkpoint
         "resume_state": null // ex: 100, loading .state  and .pth from given epoch and iteration
    },

    "speed_up": {
        "enable_amp": false,
        "fast_eval": true,
        "ena_tf32": false
    },

    "datasets": { // train or test
        "train": {
            "which_dataset": {
                "paired_dataset": {
                    "name": ["data.dataset", "LOLBasedDatasetPaired"],
                    "args":{ // arguments to initialize dataset
                        "paired_path": "train_data/paired",
                        "image_size": [192, 192]
                    }
                },
                "unpaired_dataset": {
                    "name": ["data.dataset", "UnpairedDatasetFromDirsV2"],
                    "args":{ // arguments to initialize dataset
                        "dir_list": [
                            "test_data/sid_test"
//                            "test_data/LOLv2"
                        ],
                        "image_size": [192, 192]
                    }
                },
                "valid_datasets": {
                    "LOLv2": {
                        "name": [
                            "data.dataset",
                            "PngEvalLoader"
                        ],
                        "args": {
                            // arguments to initialize dataset
                            "paired_path": "test_data/LOLv2",
                            "image_list": null
                        }
                    },
                    "SID": {
                        "name": [
                            "data.dataset",
                            "PngEvalLoader"
                        ],
                        "args": {
                            "paired_path": "test_data/sid_test",
                            "image_list": [
                                "00002.png", "00132.png", "00152.png", "00083.png",
                                "00073.png", "00096.png", "00142.png", "10178.png",
                                "00166.png", "00179.png", "20089.png", "00151.png",
                                "20210.png", "00015.png", "10176.png", "00110.png",
                                "10185.png", "00209.png", "00222.png", "00108.png",
                                "00127.png", "00047.png", "00223.png", "00001.png",
                                "00094.png", "10198.png", "00051.png", "00134.png",
                                "00098.png", "00063.png", "00165.png", "00050.png",
                                "00133.png", "00158.png", "00039.png", "00066.png",
                                "00221.png", "00157.png", "00072.png", "00099.png",
                                "10035.png", "10006.png", "10191.png", "00059.png",
                                "20211.png", "10199.png", "00141.png", "00017.png",
                                "00104.png", "10193.png", "10126.png", "00053.png",
                                "00067.png", "00009.png", "00048.png", "10032.png",
                                "00026.png", "10016.png", "00224.png", "00004.png",
                                "00086.png", "00023.png", "20079.png", "00112.png"
                            ]
                        }
                    }
                }
            },
            "dataloader":{
                "paired_args":{
                    "batch_size": 3, // mini batch size, total batch_size = batch_size * iter_per_optim_step
                    "num_workers": 8,
                    "shuffle": true,
                    "pin_memory": true,
                    "drop_last": true
                },
                "unpaired_args":{
                    "batch_size": 3, // mini batch size, total batch_size = batch_size * iter_per_optim_step
                    "num_workers": 8,
                    "shuffle": true,
                    "pin_memory": true,
                    "drop_last": true
                },
                "val_args":{
                    "batch_size": 1, // mini batch size, total batch_size = batch_size * iter_per_optim_step
                    "num_workers": 1,
                    "shuffle": false,
                    "pin_memory": true,
                    "drop_last": false
                }
            }
        },
        "test": {
            "which_dataset": {
                "valid_datasets": {
                    "LOLv2": {
                        "name": [
                            "data.dataset",
                            "PngEvalLoader"
                        ],
                        "args": {
                            "paired_path": "test_data/LOLv2",
                            "image_list": null
                        }
                    },
                    "SID": {
                        "name": [
                            "data.dataset",
                            "PngEvalLoader"
                        ],
                        "args": {
                            "paired_path": "test_data/sid_test",
                            "image_list": [
                                "00002.png", "00132.png", "00152.png", "00083.png",
                                "00073.png", "00096.png", "00142.png", "10178.png",
                                "00166.png", "00179.png", "20089.png", "00151.png",
                                "20210.png", "00015.png", "10176.png", "00110.png",
                                "10185.png", "00209.png", "00222.png", "00108.png",
                                "00127.png", "00047.png", "00223.png", "00001.png",
                                "00094.png", "10198.png", "00051.png", "00134.png",
                                "00098.png", "00063.png", "00165.png", "00050.png",
                                "00133.png", "00158.png", "00039.png", "00066.png",
                                "00221.png", "00157.png", "00072.png", "00099.png",
                                "10035.png", "10006.png", "10191.png", "00059.png",
                                "20211.png", "10199.png", "00141.png", "00017.png",
                                "00104.png", "10193.png", "10126.png", "00053.png",
                                "00067.png", "00009.png", "00048.png", "10032.png",
                                "00026.png", "10016.png", "00224.png", "00004.png",
                                "00086.png", "00023.png", "20079.png", "00112.png"
                            ]
                        }
                    }
                }
            },
            "dataloader": {
                "val_args": {
                    "batch_size": 1,
                    "num_workers": 8,
                    "pin_memory": true
                }
            }
        }
    },

    "model": {
        "which_model": {
            "name": ["models.model", "Retinol"],
            "args": {
                "optimizer":
                    {
                        "name": ["torch.optim", "AdamW"],
                        "args": {
                            "lr": 2e-4,
                            "betas": [0.9, 0.999],
                            "eps": 1e-8,
                            "weight_decay": 0
                        }
                    },
                "init_method": null
            }
        },
        "which_networks": [ // import designated list of networks using arguments
            {
                "name": ["models.NAFNet.NAFNet_arch", "NAFNetLocal"],
                "args": { // arguments to initialize network
                    "width": 64,
                    "enc_blk_nums": [1, 1, 1, 28],
                    "middle_blk_num": 1,
                    "dec_blk_nums": [1, 1, 1, 1]
                }
            }
        ],
        "which_losses": {
            "supervised_loss": [ // import designated list of losses
                {
                    "name": ["models.loss", "ModifiedSSIMLoss"],
                    "args": {
                        "loss_weight": 1
                    }
                },
                {
                    "name": ["models.loss", "LPIPSLoss"],
                    "args": {
                        "loss_weight": 1
                    }
                }
            ],
            "paired_consist_loss": [],
            "unpaired_consist_loss": [
                {
                    "name": ["models.loss", "MaskConsistencyLoss"],
                    "args": {
                        "loss_weight": 1
                    }
                }
            ],
            "paired_contrastive_loss": [
                {
                    "name": ["models.loss", "ContrastiveLoss"],
                    "args": {
                        "gamma": 10,
                        "alpha": 1,
                        "m": -0.25,
                        "range_mapping_method": "recp",
                        "loss_weight": 0.1
                    }
                }
            ],
            "unpaired_contrastive_loss": [
                {
                    "name": ["models.loss", "ContrastiveLoss"],
                    "args": {
                        "gamma": 10,
                        "alpha": 1,
                        "m": 0.25,
                        "range_mapping_method": "recp",
                        "loss_weight": 0.1
                    }
                }
            ],
            "paired_feature_loss": [],
            "unpaired_feature_loss": [],
            "cutmix_loss": []
        },
        "which_metrics": [ // import designated list of metrics
            "psnr",
            "ssim",
            "packLPIPS"
        ],
        "watching_metrics": [
            "LOLv2_psnr",
            "SID_psnr"
        ]
    },

    "train": { // arguments for basic training
        "n_epoch": 350, // max epochs
        "finish_epoch": 170,
        "val_save_epoch": 100, // valdation every specified number of epochs
        "val_epoch": 1,
        "save_checkpoint_epoch": 10,
        "semi_start_epoch": 1101,
        "semi_loss_weight": 1.0,
        "semi_loss_consistency_ramp_up": 350,
        "iter_per_optim_step": 1,
        "noise_scale": 0,

        "enable_warmup": false,
        "warmup_epochs": -3,

        "decay_change_epoch": 1132, // ununsed here
        "ema_decay_0": 0.99,
        "ema_decay_1": 0.99
    }
}
